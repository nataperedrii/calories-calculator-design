{
  "name": "ripe-calories-calculator-design",
  "private": true,
  "description": "Ripe calorie calculator: design test task. Tooling for design-system checks.",
  "type": "module",
  "scripts": {
    "check": "node 02-design-system/tools/check.mjs && node 03-screens/tools/align.mjs",
    "build:standalone": "node 02-design-system/tools/build-standalone.mjs",
    "export:png": "node 02-design-system/tools/export-png.mjs",
    "lint:css": "stylelint \"02-design-system/*.css\" 03-screens/flows.css 03-screens/prototype.css",
    "lint:html": "html-validate index.html 02-design-system/index.html 02-design-system/index.standalone.html 03-screens/index.html 03-screens/screens/*.html 03-screens/flows.html",
    "check:a11y": "node 02-design-system/tools/a11y.mjs after",
    "audit:before": "node 02-design-system/tools/a11y.mjs before",
    "build:screens": "python3 03-screens/tools/build_screens.py",
    "export:screens": "node 03-screens/tools/export.mjs",
    "check:screens": "node 03-screens/tools/check.mjs",
    "check:align": "node 03-screens/tools/align.mjs",
    "previews": "node tools/previews.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "html-validate": "^11.16.1",
    "pa11y": "^10.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
